# Copy this file to .env and adjust.

# Full path to OpenAlgo's Historify database (read-only access).
# Default when unset: ../openalgo/db/historify.duckdb relative to this folder.
HISTORIFY_DB_PATH=/path/to/openalgo/db/historify.duckdb

# Optional overrides
# INKSCREENER_SCANS_DIR=scans
# INKSCREENER_INDICES_DIR=data/indices
# INKSCREENER_BENCHMARK=NIFTY
